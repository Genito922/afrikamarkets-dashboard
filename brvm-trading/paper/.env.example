# Paper Trading Engine v1 — Variables d'environnement
# Copier vers .env et remplir les valeurs

# Binance (lecture seule suffisante pour paper trading)
BINANCE_API_KEY=your_api_key_here
BINANCE_SECRET_KEY=your_secret_key_here

# Telegram (optionnel — alertes trades)
TELEGRAM_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Base de donnees (optionnel — fallback SQLite si vide)
# DATABASE_URL=postgresql://user:password@localhost:5432/paper_trading

# Config paper trading
PAPER_ASSETS=BTCUSDT,ETHUSDT,SOLUSDT,XRPUSDT
PAPER_INTERVAL=5m
PAPER_CAPITAL=10000

# Phase de deploiement (1=BTC/ETH | 2=+SOL/XRP | 3=full)
PAPER_PHASE=1
