# ── Afrika Markets Intelligence — Production Environment ──────────────────────
# Copier ce fichier en .env.prod et remplir toutes les valeurs
# IMPORTANT : ne jamais committer .env.prod dans git

# ── Base de données PostgreSQL ────────────────────────────────────────────────
POSTGRES_USER=afrika
POSTGRES_PASSWORD=CHANGEME_strong_password_here
POSTGRES_DB=afrikamarkets
DATABASE_URL=postgresql+asyncpg://afrika:CHANGEME_strong_password_here@db:5432/afrikamarkets

# ── Sécurité ──────────────────────────────────────────────────────────────────
# Générer avec : python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGEME_generate_with_secrets_token_hex_32

# Générer avec : python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=CHANGEME_generate_with_fernet_generate_key

# ── Frontend URL (CORS) ───────────────────────────────────────────────────────
FRONTEND_URL=https://sentinel-lccafrika.space

# ── PayDunya ──────────────────────────────────────────────────────────────────
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_TOKEN=
PAYDUNYA_MODE=test

# ── Brokers (optionnel — clés globales fallback) ──────────────────────────────
# Les clés par-user sont stockées chiffrées en DB via /credentials
BINANCE_API_KEY=
BINANCE_SECRET_KEY=
DERIV_APP_ID=1011
DERIV_API_TOKEN=

# ── App ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=production
PORT=8080
ADMIN_SECRET=CHANGEME_admin_secret_for_seed_endpoint
